{
  "name": "@keyhole-koro/flowshot",
  "version": "0.1.0",
  "description": "Scenario-driven screenshot capture and flow viewer for web apps, designed for LLM-assisted UI verification.",
  "license": "MIT",
  "author": "Keyhole-Koro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keyhole-Koro/flowshot.git"
  },
  "type": "module",
  "bin": {
    "flowshot": "./bin/flowshot.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "example/site",
    "example/scenarios",
    "example/serve.ts",
    "example/flowshot.config.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "keywords": [
    "playwright",
    "screenshot",
    "visual-testing",
    "flow",
    "llm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/copy-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.dev.json",
    "prepare": "npm run build",
    "test": "npm run build && npm run typecheck && node --test test/*.test.ts",
    "example": "node example/serve.ts 4173",
    "example:capture": "cd example && node ../bin/flowshot.js run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
